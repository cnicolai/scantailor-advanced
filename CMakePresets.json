{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "/opt/homebrew",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_EXPORT_COMPILE_COMMANDS": {
          "type": "BOOL",
          "value": "ON"
        },
        "BUILD_TESTS": {
          "type": "BOOL",
          "value": "ON"
        },
        "CMAKE_FIND_FRAMEWORK": "LAST"
      }
    },
    {
      "name": "macos-release",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-debug",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-asan",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SANITIZE": "address,undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug"
    },
    {
      "name": "macos-asan",
      "configurePreset": "macos-asan"
    }
  ],
  "testPresets": [
    {
      "name": "macos-test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "macos-release",
      "inherits": "macos-test-base",
      "configurePreset": "macos-release"
    },
    {
      "name": "macos-debug",
      "inherits": "macos-test-base",
      "configurePreset": "macos-debug"
    },
    {
      "name": "macos-asan",
      "inherits": "macos-test-base",
      "configurePreset": "macos-asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "macos-asan-collect",
      "inherits": "macos-test-base",
      "configurePreset": "macos-asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=0",
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    }
  ]
}
